# Copy to .env and adjust. Never commit .env.
# All settings are prefixed with SENTINEL_.

# Where raw downloads and processed parquet files live.
SENTINEL_DATA_DIR=data

# CICIDS2017 "labelled flows" mirror (parquet). Pinned to a commit for reproducibility.
# SENTINEL_CICIDS_BASE_URL=https://huggingface.co/datasets/bvsam/cic-ids-2017/resolve/70bac6246d99cf046186a02e1cce6883e2ffe7ea/traffic_labels

# Where trained models are saved, and where MLflow records runs.
SENTINEL_MODELS_DIR=models
SENTINEL_MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Optional artifacts the API and dashboard load when present. Defaults shown.
# SENTINEL_KB_DIR=data/processed/kb
# SENTINEL_DETECTOR_DIR=models/cicids2017/best
# SENTINEL_FEATURIZER_PATH=data/processed/features/cicids2017/featurizer.json
# Normalized flow file the detection feed is built from, and how many flagged flows to keep.
# SENTINEL_DEMO_FLOWS_PATH=data/processed/events/cicids2017/Friday-WorkingHours-Afternoon-PortScan.parquet
# SENTINEL_MAX_DETECTIONS=500

# --- Later phases (placeholders, not used yet) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ABUSEIPDB_API_KEY=
